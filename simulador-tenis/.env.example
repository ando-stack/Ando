# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repositorio.

# --- Navegador (Vite): sólo la URL y la clave ANÓNIMA de Supabase. ---
# La clave anónima es pública por diseño; los datos los protege RLS (sólo lectura).
# Si se dejan vacías, la web usa el snapshot JSON de /data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Ingesta (sólo en el servidor / GitHub Actions). NUNCA con prefijo VITE_. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Despliegue desde GitHub Actions (secretos del repositorio) ---
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
