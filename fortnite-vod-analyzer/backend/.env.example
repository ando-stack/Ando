# ---- Base de datos: Supabase Postgres (Project Settings > Database > Connection string, modo "session")
# Sin DATABASE_URL se usa SQLite en DATA_DIR (solo desarrollo).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# ---- Autenticación: local | supabase
AUTH_MODE=local
APP_SECRET=cambia-esto-por-32+caracteres-aleatorios
ALLOW_REGISTRATION=true
# Con AUTH_MODE=supabase:
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_SECRET=        # solo si tu proyecto usa la clave JWT HS256 heredada; si no, se usa JWKS

# ---- Almacenamiento: local | s3 (Supabase Storage con protocolo S3)
STORAGE_BACKEND=local
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_BUCKET=fortnite-vods
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- IA
# Opción por defecto: modelo LOCAL con Ollama (gratis, sin claves, nada sale de tu PC).
#   1) Instala Ollama (https://ollama.com)   2) ollama pull qwen2.5vl:7b
VISION_PROVIDER=ollama
VISION_MODEL=qwen2.5vl:7b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MAX_IMAGES=6        # imágenes por petición (súbelo si tu GPU aguanta)
OLLAMA_IMAGE_SIDE=896      # lado máximo de cada fotograma enviado al modelo
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=900
# Alternativa: API de Claude (mejor calidad, de pago)
# VISION_PROVIDER=anthropic
# VISION_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
VISION_EFFORT=high
VISION_FALLBACKS=true
VISION_CONCURRENCY=3
# WHISPER_MODEL=small        # requiere pip install faster-whisper

# ---- Límites y muestreo
MAX_VIDEO_MB=8192
MAX_VIDEO_MINUTES=240
MAX_REPLAY_MB=200
UPLOAD_CHUNK_MB=8
SEGMENT_SECONDS=60
MAX_FRAMES_PER_SEGMENT=14
MAX_FRAMES_TOTAL=480

# ---- Replays: adaptador FortniteReplayDecompressor (opcional, ver replay-tools/)
# FRD_CLI=/opt/frdexport/FrdExport

# ---- Worker: true = worker dentro del proceso de la API (desarrollo)
EMBEDDED_WORKER=false
