# URL pública del backend (FastAPI). Solo URLs públicas aquí: nunca claves de IA.
NEXT_PUBLIC_API_URL=http://localhost:8000
# "local" (cuentas propias del backend) o "supabase"
NEXT_PUBLIC_AUTH_MODE=local
# Solo con AUTH_MODE=supabase (la anon key es pública por diseño)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
