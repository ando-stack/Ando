# Copia este archivo a .env (o exporta las variables) antes de arrancar el backend.
ANTHROPIC_API_KEY=            # obligatoria para analizar/generar; solo vive en el servidor
CLASSFORGE_MODEL=claude-opus-5-5
CLASSFORGE_EFFORT=high        # low | medium | high | xhigh | max
CLASSFORGE_FALLBACKS=1        # reintento automático en otro modelo si el principal rechaza
CLASSFORGE_AI_REVIEW=1        # revisión final del resultado con IA
CLASSFORGE_RETENTION_HOURS=24 # borrado automático de archivos
CLASSFORGE_MAX_FILE_MB=20
CLASSFORGE_MAX_TOTAL_MB=60
CLASSFORGE_MAX_FILES=10
CLASSFORGE_JOBS_PER_DAY=30
CLASSFORGE_AI_CALLS_PER_HOUR=40
CLASSFORGE_CORS_ORIGINS=http://localhost:3000
# CLASSFORGE_DATA_DIR=/ruta/datos
# CLASSFORGE_SOFFICE=/usr/bin/soffice
