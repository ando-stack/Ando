# Copia este archivo a .env y ajusta lo que necesites. .env NO se sube al repositorio.

# --- Motor local ---
ESTUDIO_PUERTO=8000
# cpu | cuda | mps  (vacío = detección automática)
ESTUDIO_DISPOSITIVO=
# RAM libre mínima (GB) para usar BiRefNet en CPU; por debajo se usa SAM + ViTMatte
ESTUDIO_RAM_BIREFNET_GB=7.5

# --- Opciones en la nube (DESACTIVADAS por defecto) ---
# Relleno generativo con la API oficial de imágenes de OpenAI. Tiene coste por imagen
# (gpt-image-1-mini, calidad media, 1024x1024 ≈ 0,011 USD + tokens de entrada; ver docs/modelos.md).
# Las imágenes solo se envían si NUBE_ACTIVADA=true, hay clave y confirmas cada envío en el editor.
NUBE_ACTIVADA=false
OPENAI_API_KEY=
# gpt-image-1-mini | gpt-image-1.5 | gpt-image-2
NUBE_MODELO=gpt-image-1-mini
# low | medium | high
NUBE_CALIDAD=medium
