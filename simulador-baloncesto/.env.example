# Copia este archivo como .env (nunca lo subas al repositorio).

# --- Ingesta (scripts de Node, servidor o GitHub Actions) ---
# URL del proyecto de Supabase y clave de servicio (escritura; solo para la ingesta)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Funciones de Netlify (variables de entorno del sitio, no del navegador) ---
# Clave anónima (solo lectura, protegida por RLS) que usa /api/snapshot en el servidor
SUPABASE_ANON_KEY=

# --- Interfaz (Vite) ---
# "static" (por defecto): usa los snapshots JSON de public/data generados por la ingesta.
# "supabase": pide los datos a /api/snapshot (función de Netlify) y, si falla, usa los estáticos.
VITE_DATA_MODE=static
