---
import Logo from './Logo.astro';
import { getSite } from '../lib/site';
const site = await getSite();
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <Logo class="preloader__mark" animated strokeWidth={5} />
    <div class="preloader__meta micro">
      <span>{site.brand}</span>
      <span class="preloader__count" data-preloader-count>000</span>
    </div>
    <div class="preloader__track"><span class="preloader__bar" data-preloader-bar></span></div>
  </div>
</div>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--aam-bg);
    color: var(--aam-fg);
    align-items: center;
    justify-content: center;
    clip-path: inset(0% 0% 0% 0%);
  }
  :global(html.show-preloader) .preloader {
    display: flex;
  }
  .preloader__inner {
    width: min(20rem, 70vw);
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }
  .preloader :global(.preloader__mark) {
    width: clamp(5rem, 4rem + 6vw, 8rem);
    color: var(--aam-accent);
  }
  .preloader__meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    color: var(--aam-fg-muted);
  }
  .preloader__count {
    font-variant-numeric: tabular-nums;
    color: var(--aam-fg);
  }
  .preloader__track {
    width: 100%;
    height: 1px;
    background: var(--aam-line);
    overflow: hidden;
  }
  .preloader__bar {
    display: block;
    height: 100%;
    background: var(--aam-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
