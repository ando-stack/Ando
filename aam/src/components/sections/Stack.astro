---
import SectionHeading from '../SectionHeading.astro';
import { getSite } from '../../lib/site';

const { stack } = await getSite();
const half = Math.ceil(stack.length / 2);
const rows = stack.length > 6 ? [stack.slice(0, half), stack.slice(half)] : [stack];
---

<section id="stack" class="section stack" aria-labelledby="stack-title">
  <div class="container-site">
    <SectionHeading number="03" label="Stack y habilidades" title="Herramientas con las que trabajo" id="stack-title" />
  </div>

  <div class="stack__rows">
    {
      rows.map((row, r) => (
        <div class="marquee" data-direction={r % 2 ? 'reverse' : 'normal'}>
          <ul class="marquee__track">
            {row.map((item) => (
              <li class="stack__item">
                <span class="stack__star" aria-hidden="true">
                  ✦
                </span>
                {item}
              </li>
            ))}
          </ul>
          <ul class="marquee__track" aria-hidden="true">
            {row.map((item) => (
              <li class="stack__item">
                <span class="stack__star">✦</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stack__rows {
    display: grid;
    gap: clamp(0.5rem, 0.2rem + 1vw, 1.25rem);
    border-block: 1px solid var(--aam-line);
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .stack__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    white-space: nowrap;
    font-family: var(--aam-font-display);
    font-weight: 700;
    font-size: var(--aam-text-2xl);
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color var(--aam-duration-fast);
  }
  .stack__item:hover {
    color: var(--aam-accent-ink);
  }
  .marquee[data-direction='reverse'] .stack__item {
    color: transparent;
    -webkit-text-stroke: 1px var(--aam-fg);
  }
  .marquee[data-direction='reverse'] .stack__item:hover {
    color: var(--aam-fg);
  }
  .stack__star {
    color: var(--aam-accent-ink);
    font-size: 0.5em;
    -webkit-text-stroke: 0;
  }
</style>
