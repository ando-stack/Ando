---
import { render } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import { getExperience } from '../../lib/site';

const entries = await Promise.all(
  (await getExperience()).map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<section id="experiencia" class="section experience" aria-labelledby="experience-title">
  <div class="container-site">
    <SectionHeading number="05" label="Experiencia" title="Trayectoria" id="experience-title" />

    <div class="timeline" data-timeline>
      <span class="timeline__track" aria-hidden="true"><span class="timeline__line" data-timeline-line></span></span>
      <ol class="timeline__list">
      {
        entries.map(({ entry, Content }) => (
          <li class="timeline__item" data-timeline-item>
            <span class="timeline__dot" data-timeline-dot aria-hidden="true" />
            <p class="micro timeline__period">
              {entry.data.start} — {entry.data.end}
            </p>
            <div class="timeline__body">
              <h3 class="timeline__role">{entry.data.role}</h3>
              <p class="timeline__company">
                {entry.data.company}
                {entry.data.location && <span class="timeline__location"> · {entry.data.location}</span>}
              </p>
              <div class="timeline__desc">
                <Content />
              </div>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }
  .timeline__list {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .timeline__track {
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: var(--aam-line);
  }
  .timeline__line {
    position: absolute;
    inset: 0;
    background: var(--aam-accent-ink);
    transform-origin: top;
  }
  :global(html:not(.motion)) .timeline__line {
    display: none;
  }
  .timeline__item {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }
  .timeline__dot {
    position: absolute;
    left: -2.5rem;
    top: 0.2rem;
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: 50%;
    border: 1px solid var(--aam-line-strong);
    background: var(--aam-bg);
    transition: background-color var(--aam-duration-base), border-color var(--aam-duration-base);
  }
  .timeline__item:global(.is-active) .timeline__dot {
    background: var(--aam-accent);
    border-color: var(--aam-accent);
  }
  .timeline__period {
    color: var(--aam-accent-ink);
  }
  .timeline__role {
    font-size: var(--aam-text-xl);
    line-height: 1.1;
  }
  .timeline__company {
    margin-top: 0.4rem;
    font-weight: 500;
  }
  .timeline__location {
    color: var(--aam-fg-muted);
    font-weight: 400;
  }
  .timeline__desc {
    margin-top: 1rem;
    color: var(--aam-fg-muted);
    max-width: 60ch;
  }
  @media (min-width: 900px) {
    .timeline {
      padding-left: 0;
    }
    .timeline__track {
      left: calc(30% - 2rem + 0.4375rem);
    }
    .timeline__item {
      grid-template-columns: calc(30% - 2rem) 1fr;
      column-gap: 2rem;
      padding-left: 0;
    }
    .timeline__body {
      padding-left: 2.5rem;
    }
    .timeline__dot {
      left: calc(30% - 2rem);
    }
    .timeline__period {
      padding-top: 0.2rem;
      text-align: right;
      padding-right: 2rem;
    }
  }
</style>
