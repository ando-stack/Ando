# Copia este archivo como .env y rellena tu clave. Nunca subas .env al repositorio.
# Sin clave el editor funciona igual (silencios, subtítulos, color, caras y edición manual),
# pero el chat y las decisiones creativas (títulos, emojis, zooms suaves, transiciones) se desactivan.
ANTHROPIC_API_KEY=

# Modelo de Claude (por defecto, el más capaz disponible)
# ANTHROPIC_MODEL=claude-opus-5-5

# Transcripción local (faster-whisper): tiny, base, small, medium, large-v3
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto        # cpu, cuda o auto
# WHISPER_COMPUTE=int8       # int8 (CPU), float16 (GPU)

# Servidor
# HOST=127.0.0.1
# PORT=8000
# PROJECTS_DIR=./projects

# Render: navegador propio para Remotion (si no, se descarga Chrome Headless Shell la primera vez)
# REMOTION_BROWSER_EXECUTABLE=
# RENDER_CONCURRENCY=4
