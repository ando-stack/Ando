# ─── Frontend (se exponen al navegador: SOLO valores públicos) ───
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# ─── Servidor (Netlify Functions). NUNCA con prefijo VITE_ ───
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=clave-service-role-secreta
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de Claude (por defecto claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Secreto para que las funciones se llamen entre sí (cadena larga aleatoria)
INTERNAL_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Embeddings para pgvector (opcional). Sin clave se usa búsqueda de texto completo.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# Correo para el consentimiento de padres/tutores (opcional; sin clave el enlace se muestra en los logs)
RESEND_API_KEY=
EMAIL_FROM="Estudia <no-responder@tu-dominio.es>"
PUBLIC_SITE_URL=http://localhost:8888

# Límites diarios de IA por usuario (configurables)
AI_LIMITE_LECTURAS_DIA=40
AI_LIMITE_GENERACIONES_DIA=30
AI_LIMITE_CORRECCIONES_DIA=20
AI_LIMITE_TUTOR_DIA=60
AI_LIMITE_TOKENS_DIA=1500000
