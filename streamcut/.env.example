# ============================================================================
# STREAMCUT AI - configuracion. Copia este archivo a ".env" y ajustalo.
# NUNCA subas el archivo .env a un repositorio.
# ============================================================================

# Entorno: development | production
STREAMCUT_ENV=development

# Modo de ejecucion:
#   api         -> la API solo atiende HTTP; worker y monitor van en procesos aparte (Docker Compose).
#   all-in-one  -> la API arranca tambien los workers y el monitor (Windows sin Docker).
STREAMCUT_RUN_MODE=api
# Cola: redis (recomendado) | memory (solo all-in-one, sin Redis)
STREAMCUT_BROKER=redis

STREAMCUT_DATABASE_URL=postgresql+psycopg://streamcut:streamcut@localhost:5432/streamcut
STREAMCUT_REDIS_URL=redis://localhost:6379/0

# --- Seguridad (OBLIGATORIAS en produccion) --------------------------------
# Genera valores con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
STREAMCUT_SECRET_KEY=
# Clave Fernet para cifrar tokens OAuth en reposo:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STREAMCUT_ENCRYPTION_KEY=
# Pon true si sirves la app por HTTPS
STREAMCUT_COOKIE_SECURE=false
# URL publica del frontend (para los callbacks OAuth)
STREAMCUT_PUBLIC_BASE_URL=http://localhost:3000
STREAMCUT_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Almacenamiento ----------------------------------------------------------
STREAMCUT_STORAGE_BACKEND=local
# STREAMCUT_DATA_DIR=./data
# Compatible con S3 (AWS, MinIO, Cloudflare R2...):
# STREAMCUT_STORAGE_BACKEND=s3
# STREAMCUT_S3_BUCKET=streamcut
# STREAMCUT_S3_ENDPOINT_URL=http://localhost:9000
# STREAMCUT_S3_ACCESS_KEY=
# STREAMCUT_S3_SECRET_KEY=
STREAMCUT_DEFAULT_QUOTA_BYTES=214748364800

# --- Procesamiento -----------------------------------------------------------
# Modelos Whisper: tiny | base | small | medium | large-v3 (mas grande = mas preciso y lento)
STREAMCUT_WHISPER_MODEL=base
STREAMCUT_WHISPER_LIVE_MODEL=tiny
# auto | cpu | cuda
STREAMCUT_WHISPER_DEVICE=auto
# Codificador por hardware opcional (p. ej. h264_nvenc con GPU NVIDIA). Vacio = libx264 (CPU)
STREAMCUT_HWACCEL_ENCODER=
STREAMCUT_WORKER_CONCURRENCY=2
STREAMCUT_MAX_LIVE_INGESTS=2

# --- Directo con senal autorizada -------------------------------------------
STREAMCUT_LIVE_SEGMENT_SECONDS=4
STREAMCUT_LIVE_BUFFER_MINUTES=20
STREAMCUT_RTMP_BASE_PORT=1935
# Permitir fuentes en tu red local (tu propio OBS/servidor en LAN). Por defecto se bloquean (anti-SSRF).
STREAMCUT_ALLOW_PRIVATE_SOURCES=false
STREAMCUT_MONITOR_POLL_SECONDS=60

# --- Integraciones (obtenlas tu: no se incluyen credenciales) -----------------
# Twitch: https://dev.twitch.tv/console/apps  -> Redirect URL: <PUBLIC_BASE_URL>/api/oauth/twitch/callback
STREAMCUT_TWITCH_CLIENT_ID=
STREAMCUT_TWITCH_CLIENT_SECRET=
# YouTube Data API v3: https://console.cloud.google.com/apis/credentials
STREAMCUT_YOUTUBE_API_KEY=
# OAuth de Google (opcional) -> Redirect URI: <PUBLIC_BASE_URL>/api/oauth/youtube/callback
STREAMCUT_GOOGLE_CLIENT_ID=
STREAMCUT_GOOGLE_CLIENT_SECRET=

# --- Publicacion en redes sociales (boton "Publicar" de cada clip) -----------
# YouTube Shorts: usa STREAMCUT_GOOGLE_CLIENT_ID/_SECRET (OAuth de Google, ver arriba).
# TikTok: https://developers.tiktok.com -> Manage apps -> Content Posting API
#   Redirect URI: <PUBLIC_BASE_URL>/api/oauth/tiktok/callback
STREAMCUT_TIKTOK_CLIENT_KEY=
STREAMCUT_TIKTOK_CLIENT_SECRET=
# Instagram (Reels): https://developers.facebook.com -> app tipo "Empresa" -> producto
#   "API de Instagram con inicio de sesion de Instagram". Requiere cuenta de Instagram profesional.
STREAMCUT_INSTAGRAM_APP_ID=
STREAMCUT_INSTAGRAM_APP_SECRET=

# Frontend -> backend (solo lo usa Next.js)
STREAMCUT_BACKEND_URL=http://127.0.0.1:8000
